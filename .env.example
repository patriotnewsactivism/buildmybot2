# BuildMyBot Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ─── App (required) ──────────────────────────────────────────────────────────
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-random-string
# Comma-separated list of additional allowed CORS origins (production)
CORS_ORIGINS=
# Encrypts stored channel/integration credentials. Falls back to
# SESSION_SECRET if unset. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Database (required) ─────────────────────────────────────────────────────
# Railway/Render provide this automatically; for Supabase use the pooler URL.
DATABASE_URL=postgresql://user:pass@host:port/db

# ─── OpenAI (required for chat/embeddings) ───────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional overrides
DEFAULT_AI_MODEL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ─── Stripe (required for billing) ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WHITELABEL_PRICE_ID=price_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Supabase (required for the Vercel serverless auth/gateway functions) ────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# SERVICE ROLE key — bypasses Row Level Security entirely. Server-side only,
# NEVER expose with a VITE_ prefix, NEVER hardcode as a fallback in source.
# Required by api/gateway.ts, api/auth/login.ts, api/auth/signup.ts, api/auth/user.ts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Signs session cookies in api/auth/*.ts + api/gateway.ts. Generate with:
#   openssl rand -hex 32
# Must be set to the SAME value across all four files' deployment env (they're
# separate Vercel functions but must agree on the signing secret).
SESSION_JWT_SECRET=

# ─── Voice - Retell AI (recommended) ─────────────────────────────────────────
RETELL_API_KEY=key_...
RETELL_DEFAULT_VOICE_ID=11labs-Adrian
RETELL_WEBHOOK_SECRET=

# ─── Voice - Cartesia TTS (optional) ─────────────────────────────────────────
CARTESIA_API_KEY=sk_car_...
TTS_PROVIDER=cartesia
SHADOW_TTS_PROVIDER=

# ─── Voice - Vapi (optional alternative) ─────────────────────────────────────
VAPI_API_KEY=
VAPI_DEFAULT_VOICE_ID=
VAPI_WEBHOOK_SECRET=

# ─── Voice - Twilio (for phone numbers) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ─── Email (optional — outbound notifications) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── AI employee email automation (api/gateway.ts /api/email/*) ──────────────
# Outbound transport: set RESEND_API_KEY (recommended on Vercel) OR the SMTP_*
# block above. With neither set, drafted replies are logged but not sent.
RESEND_API_KEY=
# Shared secret your inbound-mail provider must send in the x-webhook-secret
# header (or ?secret=) when POSTing to /api/email/inbound. Generate with:
#   openssl rand -hex 32
INBOUND_EMAIL_WEBHOOK_SECRET=
# Where escalations and VIP-partner mail get forwarded (the human at the top).
PRESIDENT_EMAIL=president@buildmybot.app
# Model used by AI employees to draft email replies.
AI_EMPLOYEE_MODEL=gpt-4o-mini

# ─── Multi-provider LLM (beta) ───────────────────────────────────────────────
# Add any provider keys below and they automatically join the rotation +
# fallback chain used by the AI team, chat, and email drafting. Provider
# order when all are configured: mistral -> cohere -> kilocode -> gemini ->
# groq -> cerebras -> openrouter -> openai. Set AI_TEAM_LLM_PROVIDER to
# pin a preferred default. Requests are distributed round-robin across
# configured providers and logged to stdout as JSON.
MISTRAL_API_KEY=
COHERE_API_KEY=
KILOCODE_API_KEY=
KILOCODE_BASE_URL=https://api.kilocode.ai/v1/chat/completions
KILOCODE_MODEL=kilocode-llm
AI_TEAM_LLM_PROVIDER=

# ─── Knowledge base (optional) ───────────────────────────────────────────────
# Firecrawl improves website scraping for the knowledge base
FIRECRAWL_API_KEY=
# Interval for the self-healing knowledge repair job (ms)
KNOWLEDGE_REPAIR_INTERVAL_MS=

# ─── Frontend (build-time, Vite) ─────────────────────────────────────────────
# Base URL of the backend API (leave empty to use same-origin /api)
VITE_API_URL=http://localhost:3001

# ─── Observability (optional) ────────────────────────────────────────────────
VITE_SENTRY_DSN=
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=

# ─── Feature flags (optional, default off unless noted) ─────────────────────
FEATURE_MULTI_TENANT=
FEATURE_PARTNER_IMPERSONATION=
FEATURE_VOICE_AGENT=
FEATURE_MULTI_CHANNEL=
FEATURE_ADVANCED_ANALYTICS=
FEATURE_REAL_TIME_METRICS=
FEATURE_BOT_TEMPLATES=
FEATURE_SIMPLIFIED_WIZARD=
FEATURE_AB_TESTING=
FEATURE_CLIENT_DASHBOARD=
FEATURE_REDIS_CACHE=
LAUNCH_GATE_ENABLED=

# Secret required to call GET /api/ai-employees/shift directly (Vercel Cron sends its own auth automatically; set this if you want to guard manual calls too)
CRON_SECRET=
