# BuildMyBot Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real .env values to git.

# ─── App / runtime ────────────────────────────────────────────────────────────
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
PORT=8080
SESSION_SECRET=change-me-to-a-random-string
SESSION_JWT_SECRET=
CORS_ORIGINS=
# AES-256-GCM key material for stored provider/subaccount credentials.
ENCRYPTION_KEY=
# Deployment provenance. Railway injects RAILWAY_GIT_COMMIT_SHA automatically;
# Cloud Run sets BUILD_SHA in its workflow.
BUILD_SHA=

# ─── Supabase (production ref: blyebndyrojmreensbxe) ────────────────────────
# Do not run production db push until docs/MIGRATION_BASELINE_RECONCILIATION.md
# has been completed. These values configure the running application only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Optional direct Postgres connection used by legacy/server-side paths.
DATABASE_URL=postgresql://user:pass@host:port/db

# ─── AI providers / embeddings ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
DEFAULT_AI_MODEL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
GITHUB_TOKEN_4=

# Autonomous AI Team resource governor
AI_TEAM_LLM_PROVIDER=openrouter
AI_TEAM_PAID_FALLBACK=off
AI_TEAM_MAX_OUTPUT_TOKENS=1024
LLM_DAILY_BUDGET_CALLS=500
AI_TEAM_KILL_SWITCH=false
SALES_AUTOMATION_DRY_RUN=true
SALES_AGENTS_MODE=research

# ─── Lead discovery / research ───────────────────────────────────────────────
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# ─── Knowledge / Firecrawl ───────────────────────────────────────────────────
FIRECRAWL_API_KEY=
# Optional shared secret sent on crawl webhook requests and verified by the app.
FIRECRAWL_WEBHOOK_SECRET=
KNOWLEDGE_REPAIR_INTERVAL_MS=

# ─── Stripe / billing ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WHITELABEL_PRICE_ID=price_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# SMS subscription prices must match shared/sms.ts exactly.
STRIPE_PRICE_SMS_STARTER=
STRIPE_PRICE_SMS_GROWTH=
STRIPE_PRICE_SMS_SCALE=

# ─── SMS automation launch gates ─────────────────────────────────────────────
# Keep false until the production DB baseline, Telnyx provisioning, send/receive,
# consent/STOP behavior, worker execution, and customer UI are verified E2E.
SMS_LAUNCH_ENABLED=false
# Bearer secret required by the durable SMS worker endpoint.
SMS_WORKER_SECRET=

# ─── Telephony / SMS — Telnyx ───────────────────────────────────────────────
TELNYX_API_KEY=KEY...
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PUBLIC_KEY=

# ─── Voice — Gemini Live + current Twilio realtime bridge ───────────────────
# Gemini Live is the intended realtime engine. The current bidirectional media
# bridge remains Twilio-based until the Telnyx voice migration passes E2E.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...
# Stable HTTPS origin reachable by the telephony provider.
TWILIO_WEBHOOK_BASE_URL=

# Optional/fallback voice providers still referenced by product code.
RETELL_API_KEY=key_...
RETELL_DEFAULT_VOICE_ID=11labs-Adrian
RETELL_WEBHOOK_SECRET=
CARTESIA_API_KEY=sk_car_...
TTS_PROVIDER=cartesia
SHADOW_TTS_PROVIDER=
VAPI_API_KEY=
VAPI_DEFAULT_VOICE_ID=
VAPI_WEBHOOK_SECRET=

# ─── Email / AI employee mail ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
INBOUND_EMAIL_WEBHOOK_SECRET=
PRESIDENT_EMAIL=president@buildmybot.app
AI_EMPLOYEE_MODEL=gpt-4o-mini

# ─── Scheduled/internal operations ───────────────────────────────────────────
CRON_SECRET=
PORTFOLIO_INTAKE_SECRET=
PORTFOLIO_OWNER_EMAIL=
BASE44_SUPERAGENT_API_KEY=

# ─── Frontend build-time variables ──────────────────────────────────────────
# Leave VITE_API_URL empty in production so browser requests stay same-origin.
VITE_API_URL=http://localhost:3001
VITE_SENTRY_DSN=
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=

# ─── Cloudflare Pages Function origins ──────────────────────────────────────
# Production defaults in functions/* are Railway primary and Cloud Run fallback.
# Set these only when intentionally overriding those defaults.
BUILDMYBOT_PRIMARY_API_ORIGIN=
BUILDMYBOT_FALLBACK_API_ORIGIN=
# Legacy value; current functions treat it as fallback, not primary.
BUILDMYBOT_API_ORIGIN=

# ─── Server observability ────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Feature flags ───────────────────────────────────────────────────────────
FEATURE_MULTI_TENANT=
FEATURE_PARTNER_IMPERSONATION=
FEATURE_VOICE_AGENT=
FEATURE_MULTI_CHANNEL=
FEATURE_ADVANCED_ANALYTICS=
FEATURE_REAL_TIME_METRICS=
FEATURE_BOT_TEMPLATES=
FEATURE_SIMPLIFIED_WIZARD=
FEATURE_AB_TESTING=
FEATURE_CLIENT_DASHBOARD=
FEATURE_REDIS_CACHE=
LAUNCH_GATE_ENABLED=
