# BuildMyBot Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ─── App (required) ──────────────────────────────────────────────────────────
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-random-string
# Comma-separated list of additional allowed CORS origins (production)
CORS_ORIGINS=
# Encrypts stored channel/integration credentials. Falls back to
# SESSION_SECRET if unset. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Database (required) ─────────────────────────────────────────────────────
# For Supabase use the transaction-pooler URL for serverless connections.
DATABASE_URL=postgresql://user:pass@host:port/db

# ─── OpenAI (required for chat/embeddings) ───────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional overrides
DEFAULT_AI_MODEL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ─── Stripe (required for billing) ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WHITELABEL_PRICE_ID=price_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Supabase (required for the Cloud Run auth/gateway functions) ────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://your-project.supabase.co
# SERVICE ROLE key — bypasses Row Level Security entirely. Server-side only,
# NEVER expose with a VITE_ prefix, NEVER hardcode as a fallback in source.
# Required by api/gateway.ts, api/auth/login.ts, api/auth/signup.ts, api/auth/user.ts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Signs session cookies in api/auth/*.ts + api/gateway.ts. Generate with:
#   openssl rand -hex 32
SESSION_JWT_SECRET=

# ─── Autonomous AI Team resource governor ──────────────────────────────────
# Internal shifts use OpenRouter's DeepSeek V4 stack for reasoning.
AI_TEAM_LLM_PROVIDER=openrouter
AI_TEAM_PAID_FALLBACK=off
AI_TEAM_MAX_OUTPUT_TOKENS=1024
LLM_DAILY_BUDGET_CALLS=500
AI_TEAM_KILL_SWITCH=false
SALES_AUTOMATION_DRY_RUN=true
# Keep the five sales agents in lead-research mode until deliberate outreach launch.
SALES_AGENTS_MODE=research

# Production AI Team provider chain. OPENROUTER_API_KEY_2 is preferred;
# OPENROUTER_API_KEY is the fallback. Store these in Google Secret Manager or
# GitHub production secrets — never commit real values here.
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
GITHUB_TOKEN_4=

# ─── Lead discovery / research ───────────────────────────────────────────────
# researchLeads() requires Tavily and grounds every inserted prospect in a
# returned search URL before OpenRouter qualifies it. A research-only GitHub
# Actions swarm can run the dedicated researcher plus five sales researchers
# without enabling outbound email or phone automation.
TAVILY_API_KEY=
# Optional enrichment/search providers available for future provider fallback.
BRAVE_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# ─── Voice - Retell AI (recommended) ─────────────────────────────────────────
RETELL_API_KEY=key_...
RETELL_DEFAULT_VOICE_ID=11labs-Adrian
RETELL_WEBHOOK_SECRET=

# ─── Voice - Cartesia TTS (optional) ─────────────────────────────────────────
CARTESIA_API_KEY=sk_car_...
TTS_PROVIDER=cartesia
SHADOW_TTS_PROVIDER=

# ─── Voice - Vapi (optional alternative) ─────────────────────────────────────
VAPI_API_KEY=
VAPI_DEFAULT_VOICE_ID=
VAPI_WEBHOOK_SECRET=

# ─── Voice - Twilio (for phone numbers) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ─── Email (optional — outbound notifications) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── AI employee email automation (api/gateway.ts /api/email/*) ──────────────
# Outbound transport: set RESEND_API_KEY (recommended on Cloud Run) OR SMTP_*
# block above. With neither set, drafted replies are logged but not sent.
RESEND_API_KEY=
# Shared secret your inbound-mail provider must send in the x-webhook-secret
# header (or ?secret=) when POSTing to /api/email/inbound. Generate with:
#   openssl rand -hex 32
INBOUND_EMAIL_WEBHOOK_SECRET=
# Where escalations and VIP-partner mail get forwarded (the human at the top).
PRESIDENT_EMAIL=president@buildmybot.app
# Model used by AI employees to draft email replies.
AI_EMPLOYEE_MODEL=gpt-4o-mini

# ─── Knowledge base (optional) ───────────────────────────────────────────────
# Firecrawl improves website scraping for the knowledge base and can be reused
# for prospect-site enrichment after discovery.
FIRECRAWL_API_KEY=
# Interval for the self-healing knowledge repair job (ms)
KNOWLEDGE_REPAIR_INTERVAL_MS=

# ─── Frontend (build-time, Vite) ─────────────────────────────────────────────
# Base URL of the backend API (leave empty to use same-origin /api)
VITE_API_URL=http://localhost:3001

# ─── Observability (optional) ────────────────────────────────────────────────
VITE_SENTRY_DSN=
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=

# ─── Feature flags (optional, default off unless noted) ─────────────────────
FEATURE_MULTI_TENANT=
FEATURE_PARTNER_IMPERSONATION=
FEATURE_VOICE_AGENT=
FEATURE_MULTI_CHANNEL=
FEATURE_ADVANCED_ANALYTICS=
FEATURE_REAL_TIME_METRICS=
FEATURE_BOT_TEMPLATES=
FEATURE_SIMPLIFIED_WIZARD=
FEATURE_AB_TESTING=
FEATURE_CLIENT_DASHBOARD=
FEATURE_REDIS_CACHE=
LAUNCH_GATE_ENABLED=

# Secret required to call GET /api/ai-employees/shift directly.
CRON_SECRET=
