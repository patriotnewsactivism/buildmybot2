{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The server runs under tsx (esbuild) in every environment — dev
    // (`npm run server`) and production (`npm start`) alike — so this config
    // is a TYPE CHECK, not a compile step. Bundler resolution matches tsx's
    // extensionless-import semantics; NodeNext would demand `.js` suffixes
    // on every relative import that the runtime doesn't need.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "noEmit": true
  },
  "include": [
    "server/**/*.ts",
    "scripts/**/*.ts",
    "drizzle.config.ts",
    "shared/**/*.ts",
    "constants.ts",
    "types.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "vite-env.d.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.tsx"
  ]
}
